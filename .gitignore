# Kirby CMS core and plugins (installed by getkirby/composer-installer)
/kirby/
/site/plugins/*
!/site/plugins/schmoll-studio-contact-form/
!/site/plugins/schmoll-studio-contact-form/**
!/site/plugins/schmoll-studio-best-practices/
!/site/plugins/schmoll-studio-best-practices/**
!/site/plugins/schmoll-studio-block-borders/
!/site/plugins/schmoll-studio-block-borders/**
!/site/plugins/schmoll-studio-block-layout/
!/site/plugins/schmoll-studio-block-layout/**
/sessions
site/sessions/
site/accounts/
site/cache/
/media
**/media/
/content/_changes/
**/_changes/

# Kirby runtime storage (cache, sessions, logs, thumbnails)
/storage/

# Composer vendor directory
/vendor/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Misc.
robots.txt
/node_modules
/TEMP
**/TEMP/
